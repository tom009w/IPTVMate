<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/tv_focusable_background"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <TextView
        android:id="@+id/tvOrderNumber"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:textColor="#FFB0B0B0"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/ivFavoriteToggle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/tv_focusable_background"
        android:clickable="true"
        android:contentDescription="@string/favorite_toggle"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/btn_star_big_off" />

    <TextView
        android:id="@+id/tvOrderChannelName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnMoveUp"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/tv_focusable_background"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:text="@string/move_up"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnMoveDown"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:background="@drawable/tv_focusable_background"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:text="@string/move_down"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp" />

</LinearLayout>
