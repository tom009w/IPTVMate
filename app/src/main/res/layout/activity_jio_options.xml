<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cinema_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/jio_options_title"
            android:textColor="@color/cinema_text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Category Mode -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/jio_category_mode"
            android:textColor="@color/cinema_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgCategoryMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbModeDefault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/jio_mode_default"
                android:textColor="@color/cinema_text_primary"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbModeSplit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/jio_mode_split"
                android:textColor="@color/cinema_text_primary"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbModeLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/jio_mode_language"
                android:textColor="@color/cinema_text_primary"
                android:textSize="16sp" />
        </RadioGroup>

        <!-- Subscription Filter -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/jio_sub_filter"
            android:textColor="@color/cinema_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgSubFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbSubAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/jio_sub_all"
                android:textColor="@color/cinema_text_primary"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbSubHide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/jio_sub_hide"
                android:textColor="@color/cinema_text_primary"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbSubOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/jio_sub_only"
                android:textColor="@color/cinema_text_primary"
                android:textSize="16sp" />
        </RadioGroup>

        <!-- Quality -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchHighQuality"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/tv_focusable_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="16dp"
            android:text="@string/jio_high_quality"
            android:textColor="@color/cinema_text_primary"
            android:textSize="16sp" />

        <!-- Languages -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/jio_languages_title"
            android:textColor="@color/cinema_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/jio_languages_subtitle"
            android:textColor="@color/cinema_text_secondary"
            android:textSize="14sp" />

        <GridLayout
            android:id="@+id/gridLanguages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:columnCount="2" />

        <Button
            android:id="@+id/btnApplyJioOptions"
            android:layout_width="240dp"
            android:layout_height="60dp"
            android:background="@drawable/tv_focusable_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:text="@string/jio_apply_button"
            android:textColor="@color/cinema_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
