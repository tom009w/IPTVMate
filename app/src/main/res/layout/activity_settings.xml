<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cinema_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="@string/settings"
            android:textColor="@color/cinema_text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/default_playlist_url"
            android:textColor="@color/cinema_text_secondary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etSettingsPlaylistUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:autofillHints="uri"
            android:hint="@string/playlist_url_hint"
            android:inputType="textUri"
            android:maxLines="1"
            android:nextFocusDown="@+id/etSettingsEpgUrl"
            android:textColor="@color/cinema_text_primary"
            android:textColorHint="#80FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/epg_url_label"
            android:textColor="@color/cinema_text_secondary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etSettingsEpgUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:autofillHints="uri"
            android:hint="@string/epg_url_hint"
            android:inputType="textUri"
            android:maxLines="1"
            android:nextFocusUp="@+id/etSettingsPlaylistUrl"
            android:nextFocusDown="@+id/btnManagePlaylists"
            android:textColor="@color/cinema_text_primary"
            android:textColorHint="#80FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnManagePlaylists"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/tv_focusable_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:nextFocusUp="@+id/etSettingsEpgUrl"
            android:nextFocusDown="@+id/btnRearrangeChannels"
            android:text="@string/manage_playlists"
            android:textColor="@color/cinema_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRearrangeChannels"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/tv_focusable_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:nextFocusUp="@+id/btnManagePlaylists"
            android:nextFocusDown="@+id/btnRearrangeCategories"
            android:text="@string/rearrange_channels"
            android:textColor="@color/cinema_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRearrangeCategories"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/tv_focusable_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:nextFocusUp="@+id/btnRearrangeChannels"
            android:nextFocusDown="@+id/btnAutoPlayToggle"
            android:text="@string/rearrange_categories"
            android:textColor="@color/cinema_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAutoPlayToggle"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/tv_focusable_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:nextFocusUp="@+id/btnRearrangeCategories"
            android:nextFocusDown="@+id/btnAdditionalSettings"
            android:text="@string/auto_play_last_channel_off"
            android:textColor="@color/cinema_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAdditionalSettings"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/tv_focusable_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:nextFocusUp="@+id/btnAutoPlayToggle"
            android:nextFocusDown="@+id/btnSaveSettings"
            android:text="@string/additional_settings_button"
            android:textColor="@color/cinema_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:background="@drawable/tv_focusable_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:nextFocusUp="@+id/btnAdditionalSettings"
            android:text="@string/save_settings"
            android:textColor="@color/cinema_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
