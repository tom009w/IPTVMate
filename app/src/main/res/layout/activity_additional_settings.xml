<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cinema_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="@string/additional_settings_title"
            android:textColor="@color/cinema_text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/xtream_section_title"
            android:textColor="@color/cinema_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etXtreamServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:autofillHints="uri"
            android:hint="@string/xtream_server_hint"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/cinema_text_primary"
            android:textColorHint="#80FFFFFF"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etXtreamUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:autofillHints="username"
            android:hint="@string/xtream_username_hint"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/cinema_text_primary"
            android:textColorHint="#80FFFFFF"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etXtreamPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:autofillHints="password"
            android:hint="@string/xtream_password_hint"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="@color/cinema_text_primary"
            android:textColorHint="#80FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnSaveXtream"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/tv_focusable_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:text="@string/xtream_connect_button"
            android:textColor="@color/cinema_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/mac_portal_section_title"
            android:textColor="@color/cinema_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etMacPortalUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:autofillHints="uri"
            android:hint="@string/mac_portal_url_hint"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/cinema_text_primary"
            android:textColorHint="#80FFFFFF"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etMacAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:autofillHints="name"
            android:hint="@string/mac_address_hint"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/cinema_text_primary"
            android:textColorHint="#80FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnSaveMacPortal"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/tv_focusable_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:text="@string/mac_portal_connect_button"
            android:textColor="@color/cinema_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/stalker_portal_section_title"
            android:textColor="@color/cinema_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etStalkerPortalUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:autofillHints="uri"
            android:hint="@string/stalker_portal_url_hint"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/cinema_text_primary"
            android:textColorHint="#80FFFFFF"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etStalkerMacAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:autofillHints="name"
            android:hint="@string/stalker_mac_hint"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/cinema_text_primary"
            android:textColorHint="#80FFFFFF"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etStalkerSerial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:autofillHints="name"
            android:hint="@string/stalker_serial_hint"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/cinema_text_primary"
            android:textColorHint="#80FFFFFF"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etStalkerDeviceId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:autofillHints="name"
            android:hint="@string/stalker_device_id_hint"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/cinema_text_primary"
            android:textColorHint="#80FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnSaveStalker"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:background="@drawable/tv_focusable_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:text="@string/stalker_connect_button"
            android:textColor="@color/cinema_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
