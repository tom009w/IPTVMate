<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E1E2E"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/playlist_dialog_title"
        android:textColor="#00E5FF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/playlist_dialog_subtitle"
        android:textColor="#E0E0E0"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etPlaylistUrl"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#2A2A3E"
        android:autofillHints="uri"
        android:hint="@string/playlist_url_hint"
        android:inputType="textUri"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:singleLine="true"
        android:textColor="#FFFFFFFF"
        android:textColorHint="#80E0E0E0"
        android:textSize="16sp" />

</LinearLayout>
